# Copy this file to `.env` and fill in the values. The real `.env` is git-ignored.
# All values are PUBLIC, read-only client configuration — never add a secret
# Sanity write token here.

# Sanity.io project ID (public) — the read-only content source (Req 12).
VITE_SANITY_PROJECT_ID=

# Sanity.io dataset name (public), e.g. "production".
VITE_SANITY_DATASET=production

# Web3Forms public access key (Req 13) — routes contact submissions to Maija's email.
VITE_WEB3FORMS_ACCESS_KEY=

# Optional social / contact overrides for the footer. When unset, the defaults
# in src/config/site.ts are used. Update these to point at Maija's real
# profiles without touching component code.
VITE_SOCIAL_LINKEDIN_URL=
VITE_SOCIAL_INSTAGRAM_URL=
VITE_CONTACT_EMAIL=
VITE_CONTACT_LOCATION=
